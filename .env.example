# REQUIRED — shared secret your team enters on the /cli-auth page.
# The container refuses to start without it.
# Generate one: openssl rand -hex 24
TEAM_TOKEN=change-me

# OPTIONAL — JWT signing secret for the short-lived upload tokens. Generated on
# first boot and persisted in the data volume when unset. Set it explicitly if
# you ever run more than one replica.
# JWT_SECRET=

# OPTIONAL — set to 1 only when a reverse proxy sits in front of the container.
# It makes the sign-in throttle trust x-forwarded-for; leaving it unset keeps
# one shared bucket, which a client cannot spoof its way around.
# TRUST_PROXY=1

# OPTIONAL — Anthropic API key. Enables the AI coach card on profiles.
# LLM_API_KEY=

# OPTIONAL — cap on an accepted upload, in bytes. Defaults to 900 KiB, matching
# the CLI's own pre-send limit.
# MAX_INGEST_BYTES=921600
