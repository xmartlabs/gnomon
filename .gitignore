# Generated outputs — contain YOUR personal transcript-derived data. Never commit.
stats.json
summary.json
report.md
profile.html
narrative_input.md
_antigravity_ide/

# Agent scratch space. Same rule, stronger reason: calibration work pulls real
# per-user rows out of the mirdash upload archive, so files here can join real
# names to per-person metrics. Tracked here rather than left to .git/info/exclude,
# which is never cloned and so protects exactly one checkout.
.context/

# Self-hosted dashboard deployment config. The README tells you to copy
# .env.example here and put TEAM_TOKEN in it — that is the shared secret that
# gates every upload, so it must never be committable. .env.example stays
# tracked; the real one never is.
.env
.env.*
!.env.example

